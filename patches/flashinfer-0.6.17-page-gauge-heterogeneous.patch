+// Materialize one heterogeneous K or V tile in native FP16 shared memory.
+// Old rows are reconstructed from signed INT8 and one scale per page/head;
+// exact rows are copied bitwise from the FP16 ring.  The unified logical page
+// table uses code-page identifiers below old_kv_len and ring-page identifiers
+// at and above it.  Only boundary/exact tiles take this path: all-old tiles
+// retain PageGauge's factorized post-MMA scaling path.
+template <bool produce_v, typename KTraits, typename SmemStorage, typename Params>
+__device__ __forceinline__ void page_produce_heterogeneous_kv(
+    SmemStorage* smem_storage, const Params& params, const uint32_t request_idx,
+    const uint32_t kv_head_idx, const uint32_t logical_tile_start,
+    const uint32_t chunk_tile_offset, const uint32_t chunk_size,
+    const uint32_t warp_idx, const uint32_t lane_idx) {
+  static_assert(KTraits::HEAD_DIM_QK == 128 && KTraits::HEAD_DIM_VO == 128);
+  static_assert(KTraits::REPACK_STRIDE_QK == KTraits::REPACK_STRIDE_VO);
+  using DTypeQ = typename KTraits::DTypeQ;
+  using DTypeKV = typename KTraits::DTypeKV;
+  using IdType = typename KTraits::IdType;
+  constexpr uint32_t NUM_WARPS = KTraits::NUM_WARPS;
+  constexpr uint32_t NUM_WARPS_Q = KTraits::NUM_WARPS_Q;
+  constexpr uint32_t NUM_MMA_KV = KTraits::NUM_MMA_KV;
+  constexpr uint32_t NUM_MMA_D =
+      produce_v ? KTraits::NUM_MMA_D_VO : KTraits::NUM_MMA_D_QK;
+  constexpr uint32_t ROWS_PER_ITER = 4;
+  constexpr uint32_t HALF_VALUES_PER_VECTOR = upcast_size<DTypeQ>();
+  static_assert(HALF_VALUES_PER_VECTOR == 8);
+  static_assert(NUM_MMA_KV * ROWS_PER_ITER % NUM_WARPS_Q == 0);
+
+  const auto& paged_kv = params.paged_kv;
+  DTypeKV* old_cache = produce_v ? paged_kv.v_data : paged_kv.k_data;
+  DTypeQ* exact_cache = produce_v ? params.exact_v_cache : params.exact_k_cache;
+  half* page_scale = produce_v ? params.v_page_scale : params.k_page_scale;
+  const uint32_t old_length = static_cast<uint32_t>(__ldg(params.old_kv_len + request_idx));
+  smem_t<KTraits::SWIZZLE_MODE_KV> exact_smem(
+      heterogeneous_kv_smem_ptr<KTraits>(smem_storage));
+  uint32_t smem_offset = exact_smem.template get_permuted_offset<
+      KTraits::REPACK_STRIDE_QK>(warp_idx * KTraits::KV_THR_LAYOUT_ROW + lane_idx / 8,
+                                 lane_idx % 8);
+
+#pragma unroll
+  for (uint32_t i = 0; i < NUM_MMA_KV * ROWS_PER_ITER / NUM_WARPS_Q; ++i) {
+    const uint32_t logical_row =
+        warp_idx * ROWS_PER_ITER + lane_idx / 8 + NUM_WARPS * ROWS_PER_ITER * i;
+    const uint32_t chunk_row = chunk_tile_offset + logical_row;
+    const bool valid = chunk_row < chunk_size;
+    const uint32_t logical_token = logical_tile_start + logical_row;
+    IdType physical_page = 0;
+    uint32_t entry_idx = 0;
+    if (valid) {
+      uint32_t logical_page;
+      paged_kv.page_size.divmod(logical_token, logical_page, entry_idx);
+      physical_page = __ldg(paged_kv.indices + paged_kv.indptr[request_idx] + logical_page);
+    }
+
+#pragma unroll
+    for (uint32_t j = 0; j < NUM_MMA_D / 4; ++j) {
+      const uint32_t feature_idx =
+          (lane_idx % 8) * HALF_VALUES_PER_VECTOR + j * 8 * HALF_VALUES_PER_VECTOR;
+      b128_t staged = make_uint4(0, 0, 0, 0);
+      if (valid) {
+        const size_t element_offset =
+            paged_kv.get_elem_offset(physical_page, kv_head_idx, entry_idx, feature_idx);
+        if (logical_token < old_length) {
+          alignas(16) DTypeQ converted[HALF_VALUES_PER_VECTOR];
+          vec_cast<DTypeQ, DTypeKV>::template cast<HALF_VALUES_PER_VECTOR>(
+              converted, old_cache + element_offset);
+          const half2 scale2 = __half2half2(
+              page_scale[static_cast<size_t>(physical_page) * paged_kv.num_heads + kv_head_idx]);
+#pragma unroll
+          for (uint32_t packed = 0; packed < HALF_VALUES_PER_VECTOR / 2; ++packed) {
+            reinterpret_cast<half2*>(converted)[packed] =
+                __hmul2(reinterpret_cast<half2*>(converted)[packed], scale2);
+          }
+          staged = *reinterpret_cast<b128_t*>(converted);
+        } else {
+          staged = *reinterpret_cast<const b128_t*>(exact_cache + element_offset);
+        }
+      }
+      exact_smem.base[smem_offset] = staged;
+      smem_offset = exact_smem.template advance_offset_by_column<8>(smem_offset, j);
+    }
+    smem_offset = exact_smem.template advance_offset_by_row<
+                      NUM_WARPS * ROWS_PER_ITER, KTraits::REPACK_STRIDE_QK>(smem_offset) -
+                  sizeof(DTypeQ) * NUM_MMA_D;
+  }
+}

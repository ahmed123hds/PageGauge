+// PageGauge's heterogeneous decode path time-shares one native-half staging
+// tile between K and V.  CTA16 INT8 kernels do not otherwise allocate the
+// repack buffer, so their adjacent INT8 K and V arrays provide exactly the
+// bytes required by one half tile.  Larger-Q kernels already own the native
+// repack buffer and use it directly.  This accessor is instantiated only for
+// Params carrying exact_k_cache/exact_v_cache/old_kv_len.
+template <typename KTraits, typename SmemStorage>
+__device__ __forceinline__ typename KTraits::DTypeQ* heterogeneous_kv_smem_ptr(
+    SmemStorage* smem_storage) {
+  static_assert(std::is_same_v<typename KTraits::DTypeQ, half>);
+  static_assert(std::is_same_v<typename KTraits::DTypeKV, int8_t>);
+  static_assert(KTraits::SWIZZLE_MODE_KV == SwizzleMode::k128B);
+  if constexpr (KTraits::USE_KV_REPACK) {
+    return smem_storage->kv_smem_repack_ptr();
+  } else {
+    static_assert(!KTraits::USE_KV_SHARED_SMEM);
+    constexpr size_t kRequiredBytes =
+        KTraits::CTA_TILE_KV *
+        (KTraits::HEAD_DIM_QK > KTraits::HEAD_DIM_VO ? KTraits::HEAD_DIM_QK
+                                                     : KTraits::HEAD_DIM_VO) *
+        sizeof(typename KTraits::DTypeQ);
+    constexpr size_t kAvailableBytes =
+        sizeof(smem_storage->k_smem) + sizeof(smem_storage->v_smem);
+    static_assert(kRequiredBytes <= kAvailableBytes,
+                  "heterogeneous half tile does not fit K/V shared storage");
+    return reinterpret_cast<typename KTraits::DTypeQ*>(smem_storage->k_smem);
+  }
+}
